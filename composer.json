{
  "name": "renatomaldonado/manticore-laravel-search",
  "description": "Laravel driver for Manticore Search using the official PHP client",
  "type": "library",
  "require": {
    "php": "^8.1",
    "laravel/framework": "^10.0|^11.0|^12.0",
    "manticoresoftware/manticoresearch-php": "^4.0"
  },
  "require-dev": {
    "orchestra/testbench": "^8.0|^9.0|^10.0",
    "pestphp/pest": "^2.0|^3.0"
  },
  "autoload": {
    "psr-4": {
      "ManticoreLaravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/pest",
    "test:unit": "vendor/bin/pest --testsuite=Unit",
    "test:integration": "vendor/bin/pest --testsuite=Integration",
    "test:coverage": "vendor/bin/pest --coverage"
  },
  "authors": [
    {
      "name": "renato maldonado",
      "email": "mallldonado@gmail.com"
    }
  ],
  "extra": {
    "laravel": {
      "providers": [
        "ManticoreLaravel\\ManticoreServiceProvider"
      ]
    }
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}